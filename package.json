{
  "name": "agentic-crm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "docs:check": "node scripts/check-docs.mjs",
    "build": "pnpm --filter @agentic-crm/contracts build && pnpm --filter @agentic-crm/testkit build && pnpm --filter @agentic-crm/backend build && pnpm --filter @agentic-crm/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "dev:web": "pnpm --filter @agentic-crm/web dev",
    "dev:api": "pnpm --filter @agentic-crm/backend dev",
    "dev:worker": "pnpm --filter @agentic-crm/backend dev:worker",
    "env:init": "node scripts/env-init.mjs",
    "dev:up": "node scripts/compose.mjs up",
    "preview:up": "node scripts/compose.mjs preview",
    "dev:status": "node scripts/compose.mjs status",
    "dev:logs": "node scripts/compose.mjs logs",
    "dev:down": "node scripts/compose.mjs down",
    "test:container": "node scripts/compose.mjs test",
    "test:smoke-api": "node scripts/smoke-api.mjs",
    "db:migrate": "node scripts/compose.mjs migrate",
    "db:status": "node scripts/compose.mjs dbstatus",
    "test:integration": "node scripts/integration.mjs",
    "lint": "node scripts/lint.mjs",
    "schemas:check": "node scripts/check-schemas.mjs",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "test:unit": "vitest run --exclude **/*.integration.test.ts",
    "verify": "node scripts/verify.mjs",
    "verify:container": "docker compose -p agentic-crm-verify -f compose.verify.yaml run --rm --build --no-deps verify",
    "auth:provision": "node scripts/auth-provision.mjs",
    "test:auth": "node scripts/auth-e2e.mjs",
    "test:identity": "node scripts/identity-e2e.mjs",
    "seed:dev": "node scripts/seed-dev.mjs",
    "test:seed": "node scripts/seed-e2e.mjs",
    "seed:registry": "node scripts/seed-registry.mjs",
    "test:registry": "node scripts/registry-e2e.mjs",
    "seed:m1": "node scripts/seed-m1.mjs",
    "test:m1": "node scripts/m1-e2e.mjs",
    "seed:channels": "node scripts/seed-channels.mjs",
    "test:intake": "node scripts/intake-e2e.mjs",
    "seed:inbox": "node scripts/seed-inbox.mjs",
    "test:inbox": "node scripts/inbox-e2e.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-schema-to-typescript": "16.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
