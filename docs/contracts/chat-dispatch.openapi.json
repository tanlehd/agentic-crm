  "components": {
    "securitySchemes": {
      "workloadLocalService": {
        "type": "apiKey",
        "in": "header",
        "name": "x-workload-service",
        "description": "Only in explicitly selected http-local development/test mode (ADR-026); no automatic TLS downgrade"
      },
      "workloadLocalKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-workload-key",
        "description": "Private configured service key; trusted local network only, paired with service and current Identity tenant admission"
      },
      "workloadMTLS": {
        "type": "mutualTLS",
        "description": "TLS1.3 peer SAN identity, active workload registry and per-operation allowlist; no identity from forwarded headers"
      }
    },
    "schemas": {
      "DispatchBinding": {
        "type": "object",
        "properties": {
          "tenant_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "crm_contact_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "connection_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "intent_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "attempt_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "principal_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "delegation_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "actor_kind": {
            "enum": [
              "human",
              "ai"
            ]
          },
          "owner_revision": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "record_version": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "payload_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "tenant_id",
          "conversation_id",
          "crm_contact_id",
          "connection_id",
          "intent_id",
          "attempt_id",
          "principal_id",
          "delegation_id",
          "actor_kind",
          "owner_revision",
          "record_version",
          "payload_digest"
        ],
        "additionalProperties": false
      },
      "DispatchResourceContext": {
        "type": "object",
        "properties": {
          "object_key": {
            "const": "conversation"
          },
          "owner_principal_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "owner_revision": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "record_version": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "team_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f-]{36}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "shared_team_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f-]{36}$"
            },
            "uniqueItems": true,
            "maxItems": 200
          }
        },
        "required": [
          "object_key",
          "owner_principal_id",
          "owner_revision",
          "record_version",
          "team_id",
          "shared_team_ids"
        ],
        "additionalProperties": false
      },
      "IdentityIssue": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": 1
          },
          "operation": {
            "const": "identity-issue"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "binding": {
            "$ref": "#/components/schemas/DispatchBinding"
          },
          "resource_context": {
            "$ref": "#/components/schemas/DispatchResourceContext"
          }
        },
        "required": [
          "schema_version",
          "operation",
          "request_id",
          "binding",
          "resource_context"
        ],
        "additionalProperties": false
      },
      "IdentityConsume": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": 1
          },
          "operation": {
            "const": "identity-consume"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "binding": {
            "$ref": "#/components/schemas/DispatchBinding"
          },
          "grant_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "claim_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "fence_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          }
        },
        "required": [
          "schema_version",
          "operation",
          "request_id",
          "binding",
          "grant_id",
          "claim_id",
          "fence_id"
        ],
        "additionalProperties": false
      },
      "ChatClaim": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": 1
          },
          "operation": {
            "const": "chat-claim"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "binding": {
            "$ref": "#/components/schemas/DispatchBinding"
          },
          "grant_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          }
        },
        "required": [
          "schema_version",
          "operation",
          "request_id",
          "binding",
