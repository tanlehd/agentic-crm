  "components": {
    "securitySchemes": {
      "nativeSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "crm_session"
      }
    },
    "schemas": {
      "uuid": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
      },
      "version": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,15}$"
      },
      "draft": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "definition"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "definition": {
            "type": "object"
          }
        }
      },
      "archive": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "archived"
        ],
        "properties": {
          "archived": {
            "type": "boolean"
          }
        }
      },
      "operation": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "body",
              "key"
            ],
            "properties": {
              "kind": {
                "const": "create"
              },
              "body": {
                "$ref": "#/components/schemas/draft"
