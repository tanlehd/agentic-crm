{
  "openapi": "3.1.0",
  "info": {
    "title": "Reporting private draft storage — native BFF",
    "version": "1.0.0",
    "description": "SRC-057. Saving metadata does not authorize source data, publish or execute queries. Native Identity read/design own/all grants; no team sharing. Private transport operation/admission schemas included for service verification only."
  },
  "security": [
    {
      "nativeSession": []
    }
  ],
