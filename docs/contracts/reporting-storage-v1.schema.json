{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:agentic-crm:reporting-storage:1",
  "definitions": {
    "uuid": {"type":"string","pattern":"^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"},
    "version": {"type":"string","pattern":"^[1-9][0-9]{0,15}$"},
    "draft": {"type":"object","additionalProperties":false,"required":["name","definition"],"properties":{"name":{"type":"string","minLength":1,"maxLength":160},"definition":{"type":"object"}}},
    "archive": {"type":"object","additionalProperties":false,"required":["archived"],"properties":{"archived":{"type":"boolean"}}},
    "operation": {
      "oneOf":[
        {"type":"object","additionalProperties":false,"required":["kind","body","key"],"properties":{"kind":{"const":"create"},"body":{"$ref":"#/definitions/draft"},"key":{"$ref":"#/definitions/uuid"}}},
        {"type":"object","additionalProperties":false,"required":["kind","id","body","key","expectedRevision"],"properties":{"kind":{"const":"update"},"id":{"$ref":"#/definitions/uuid"},"body":{"$ref":"#/definitions/draft"},"key":{"$ref":"#/definitions/uuid"},"expectedRevision":{"$ref":"#/definitions/version"}}},
        {"type":"object","additionalProperties":false,"required":["kind","id","body","key","expectedRevision"],"properties":{"kind":{"const":"archive"},"id":{"$ref":"#/definitions/uuid"},"body":{"$ref":"#/definitions/archive"},"key":{"$ref":"#/definitions/uuid"},"expectedRevision":{"$ref":"#/definitions/version"}}},
        {"type":"object","additionalProperties":false,"required":["kind","id"],"properties":{"kind":{"const":"get"},"id":{"$ref":"#/definitions/uuid"}}},
        {"type":"object","additionalProperties":false,"required":["kind","id","version"],"properties":{"kind":{"const":"version"},"id":{"$ref":"#/definitions/uuid"},"version":{"$ref":"#/definitions/version"}}},
        {"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"const":"list"},"after":{"$ref":"#/definitions/uuid"},"limit":{"type":"integer","minimum":1,"maximum":100}}}
      ]
    },
    "admission": {"type":"object","additionalProperties":false,"required":["audience","tenantId","principalId","authRevision","readScope","designScope","bodyHash","issuedAt","expiresAt"],"properties":{
      "audience":{"const":"reporting-definition-v1"},"tenantId":{"$ref":"#/definitions/uuid"},"principalId":{"$ref":"#/definitions/uuid"},"authRevision":{"$ref":"#/definitions/version"},
      "readScope":{"enum":["none","own","all"]},"designScope":{"enum":["none","own","all"]},"bodyHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"issuedAt":{"type":"integer","minimum":1},"expiresAt":{"type":"integer","minimum":1}
    }}
  }
}
