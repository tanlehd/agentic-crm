{
  "openapi": "3.1.0",
  "info": {
    "title": "Durable mock report runs",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/reporting/runs": {
      "post": {
        "operationId": "createReportingRun",
        "security": [
          {
            "nativeSession": []
          }
        ],
        "parameters": [
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/uuid"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owner-scoped mock run metadata or authorized aggregate result"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Permission denied"
          },
          "404": {
            "description": "Run unavailable"
          },
          "409": {
            "description": "Conflict, busy, incomplete or lost fence"
          },
          "410": {
            "description": "Run expired"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/request"
              }
            }
          }
        }
      }
    },
    "/api/v1/reporting/runs/{id}": {
      "get": {
        "operationId": "getReportingRun",
        "security": [
          {
            "nativeSession": []
          }
        ],
        "parameters": [
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/uuid"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owner-scoped mock run metadata or authorized aggregate result"
