              "$ref": "#/components/schemas/uuid"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "json",
                "csv"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owner-scoped mock run metadata or authorized aggregate result"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Permission denied"
          },
          "404": {
            "description": "Run unavailable"
          },
          "409": {
            "description": "Conflict, busy, incomplete or lost fence"
          },
          "410": {
            "description": "Run expired"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "nativeSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "crm_session"
      }
    },
    "schemas": {
      "uuid": {
        "type": "string",
        "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
      },
      "hash": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "definition"
        ],
        "properties": {
          "definition": {
            "type": "object",
            "required": [
              "bindingId"
            ],
            "properties": {
              "bindingId": {
                "$ref": "#/components/schemas/uuid"
              }
            }
          },
          "generation": {
            "$ref": "#/components/schemas/hash"
          }
        }
      }
    }
  }
}
