  "components": {
    "securitySchemes": {
      "workloadLocalService": {
        "type": "apiKey",
        "in": "header",
        "name": "x-workload-service",
        "description": "Only in explicitly selected http-local development/test mode (ADR-026); no automatic TLS downgrade"
      },
      "workloadLocalKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-workload-key",
        "description": "Private configured service key; trusted local network only, paired with service and current Identity tenant admission"
      },
      "workloadMTLS": {
        "type": "mutualTLS"
      }
    },
    "schemas": {
      "ChatRegistrySnapshot": {
        "type": "object",
        "properties": {
          "tenant_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "registry_revision": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "record_version": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "owner_revision": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "control_revision": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "pause_through_revision": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,19})$"
          },
          "cancel_through_revision": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,19})$"
          },
          "crm_contact_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "crm_identity_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "connection_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "owner_principal_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f-]{36}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "owner_kind": {
            "enum": [
              "human",
              "ai",
              null
            ]
          },
          "team_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f-]{36}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "shared_team_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f-]{36}$"
            },
            "uniqueItems": true,
            "maxItems": 200
          },
          "active_session_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f-]{36}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "open",
              "pending",
              "closed"
            ]
          },
          "archived": {
            "type": "boolean"
          }
        },
        "required": [
          "tenant_id",
          "conversation_id",
          "registry_revision",
          "record_version",
          "owner_revision",
          "control_revision",
          "pause_through_revision",
          "cancel_through_revision",
          "crm_contact_id",
          "crm_identity_id",
          "connection_id",
          "owner_principal_id",
          "owner_kind",
          "team_id",
          "shared_team_ids",
          "active_session_id",
          "status",
          "archived"
        ],
        "additionalProperties": false
      },
      "ChatControlNotice": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": 1
          },
          "event_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "registry_revision": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          }
        },
        "required": [
          "schema_version",
          "event_id",
          "tenant_id",
          "conversation_id",
          "registry_revision"
        ],
        "additionalProperties": false
      },
      "ChatControlEvent": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": 1
          },
          "event_type": {
            "const": "chat.registry.changed.v1"
          },
          "producer": {
            "const": "chat"
          },
          "event_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid",
