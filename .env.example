# Copy is unnecessary: pnpm env:init generates a private .env with random local secrets.
APP_ENV=development
APP_ORIGIN=http://localhost:8080
# If 8080 is unavailable, change both LOCAL_GATEWAY_PORT and APP_ORIGIN.
LOCAL_GATEWAY_PORT=8080
MYSQL_DATABASE=agentic_crm
MYSQL_USER=crm_app
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_SECRET
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_SECRET
MYSQL_MIGRATION_USER=crm_migrate
MYSQL_MIGRATION_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
OIDC_CLIENT_SECRET=REPLACE_WITH_RANDOM_SECRET
SESSION_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
AUTH_DEMO_PASSWORD=REPLACE_WITH_RANDOM_SECRET

# Synthetic seed users; generated by env:init, never commit credentials.
SEED_ALPHA_ADMIN_PASSWORD=
SEED_BETA_ADMIN_PASSWORD=
SEED_CHAT_ANNA_PASSWORD=
SEED_SALES_BINH_PASSWORD=
SEED_SALES_CHI_PASSWORD=
SEED_READ_ONLY_PASSWORD=
