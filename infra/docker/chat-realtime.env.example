# Optional ephemeral notifications. Existing SQL, ownership and durable events stay authoritative.
CHAT_REALTIME_ENABLED=false
# Chat API/worker publish here; baseline gateway subscribes using its existing REDIS_* config.
CHAT_REALTIME_REDIS_HOST=redis
CHAT_REALTIME_REDIS_PORT=6379
# Supply CHAT_REALTIME_REDIS_PASSWORD privately when Redis authentication is configured.
