              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,63}$",
                    "not": {
                      "enum": [
                        "won",
                        "lost",
                        "revenue",
                        "consent"
                      ]
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "sessions": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cohort_rate": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "previous_rate": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "key",
                  "label",
                  "sessions",
                  "cohort_rate",
                  "previous_rate"
                ]
              },
              "maxItems": 12
            },
            "from": {
              "type": "string",
              "format": "date-time"
            },
            "to": {
              "type": "string",
              "format": "date-time"
            },
            "as_of": {
              "type": "string",
              "format": "date-time"
            },
            "process_version": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "timezone": {
              "const": "UTC"
            },
            "scope": {
              "const": "current_authorized_conversations"
            },
            "mode": {
              "const": "same_need_ordered"
            }
          },
          "required": [
            "sessions",
            "denominator",
            "coverage",
            "steps",
            "from",
            "to",
            "as_of",
            "process_version",
            "timezone",
            "scope",
            "mode"
          ]
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "correlation_id": {
              "type": "string"
            }
          },
          "required": [
            "correlation_id"
          ]
        }
      },
      "required": [
        "data",
        "meta"
      ]
    }
  }
}
