{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-crm.local/schemas/connector.json",
  "definitions": {
    "connector-ack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "delivery_id": {
              "type": "string",
              "format": "uuid"
            },
            "status": {
              "enum": [
                "queued",
                "forwarded",
                "completed",
                "blocked",
                "attention"
              ]
            }
          },
          "required": [
            "delivery_id",
            "status"
          ]
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "correlation_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "correlation_id"
          ]
        }
      },
      "required": [
        "data",
        "meta"
      ]
    },
    "connector-response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "status": {
              "enum": [
                "queued",
                "forwarded",
                "completed",
                "blocked",
                "attention"
              ]
            },
            "attempts": {
              "type": "integer",
              "minimum": 0
            },
            "error_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "remote_delivery_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "status",
            "attempts",
            "error_code",
            "remote_delivery_id"
          ]
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "correlation_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "correlation_id"
          ]
        }
      },
      "required": [
        "data",
        "meta"
      ]
    },
    "connector-error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "retryable"
          ]
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "correlation_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "correlation_id"
          ]
        }
      },
      "required": [
        "error",
        "meta"
      ]
    },
    "messenger-webhook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object",
        "entry"
      ],
      "properties": {
        "object": {
          "const": "page"
        },
        "entry": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "anyOf": [
              {
                "required": [
                  "messaging"
                ]
              },
              {
                "required": [
                  "standby"
                ]
              }
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9]{1,32}$"
              },
              "time": {
                "type": "integer"
              },
              "messaging": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "required": [
                    "sender",
                    "recipient",
                    "timestamp"
                  ],
                  "properties": {
                    "sender": {
                      "type": "object",
                      "required": [
                        "id"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 255
                        }
                      }
                    },
                    "recipient": {
                      "type": "object",
                      "required": [
                        "id"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 255
                        }
                      }
                    },
                    "timestamp": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 253402300799999
                    }
                  }
                }
              },
              "standby": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "required": [
                    "sender",
                    "recipient",
                    "timestamp"
                  ],
                  "properties": {
                    "sender": {
                      "type": "object",
                      "required": [
                        "id"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 255
                        }
                      }
                    },
                    "recipient": {
                      "type": "object",
                      "required": [
                        "id"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 255
                        }
                      }
                    },
                    "timestamp": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 253402300799999
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
