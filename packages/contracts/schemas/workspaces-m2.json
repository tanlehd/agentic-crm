{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-crm.local/schemas/workspaces-m2.json",
  "definitions": {
    "m2-sales-detail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "meta"
      ],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record",
            "handoff",
            "source",
            "can_accept",
            "contact",
            "conversation_id"
          ],
          "properties": {
            "record": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "tenant_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "object_key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,19}$"
                },
                "owner_revision": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,19}$"
                },
                "owner_principal_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uuid"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "team_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uuid"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "archived": {
                  "type": "boolean"
                },
                "fields": {
                  "type": "object",
                  "additionalProperties": true
                },
                "custom_values": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "required": [
                "id",
                "tenant_id",
                "object_key",
                "version",
                "owner_revision",
                "owner_principal_id",
                "team_id",
                "archived",
                "fields",
                "custom_values"
              ]
            },
            "handoff": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "status",
                    "due_at",
                    "accepted_at",
                    "attention"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "enum": [
                        "pending",
                        "accepted",
                        "cancelled"
                      ]
                    },
                    "due_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "accepted_at": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "attention": {
                      "type": "boolean"
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "source": {
              "enum": [
                "ctm",
                "unknown",
                null
              ]
            },
            "can_accept": {
              "type": "boolean"
            },
            "contact": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "label"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "label": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "conversation_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correlation_id"
          ],
          "properties": {
            "correlation_id": {
              "type": "string"
            }
          }
        }
      }
    },
    "m2-sales-list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "next_cursor",
        "meta"
      ],
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "record",
              "handoff",
              "source",
              "can_accept",
              "contact",
              "conversation_id"
            ],
            "properties": {
              "record": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "tenant_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "object_key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,19}$"
                  },
                  "owner_revision": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,19}$"
                  },
                  "owner_principal_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uuid"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "team_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uuid"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "archived": {
                    "type": "boolean"
                  },
                  "fields": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "custom_values": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "required": [
                  "id",
                  "tenant_id",
                  "object_key",
                  "version",
                  "owner_revision",
                  "owner_principal_id",
                  "team_id",
                  "archived",
                  "fields",
                  "custom_values"
                ]
              },
              "handoff": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "status",
                      "due_at",
                      "accepted_at",
                      "attention"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "status": {
                        "enum": [
                          "pending",
                          "accepted",
                          "cancelled"
                        ]
                      },
                      "due_at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "accepted_at": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "date-time"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "attention": {
                        "type": "boolean"
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source": {
                "enum": [
                  "ctm",
                  "unknown",
                  null
                ]
              },
              "can_accept": {
                "type": "boolean"
              },
              "contact": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "label"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "label": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "conversation_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "maxItems": 50
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correlation_id"
          ],
          "properties": {
            "correlation_id": {
              "type": "string"
            }
          }
        }
      }
    },
    "m2-deliveries-list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "next_cursor",
        "meta"
      ],
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "connection_id",
              "status",
              "attempts",
              "error_code",
              "next_attempt_at",
              "received_at",
              "can_retry"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "connection_id": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "const": "failed"
              },
              "attempts": {
                "type": "integer",
                "minimum": 0
              },
              "error_code": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "next_attempt_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "received_at": {
                "type": "string",
                "format": "date-time"
              },
              "can_retry": {
                "type": "boolean"
              }
            }
          },
          "maxItems": 50
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correlation_id"
          ],
          "properties": {
            "correlation_id": {
              "type": "string"
            }
          }
        }
      }
    },
    "m2-runs-list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "next_cursor",
        "meta"
      ],
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "current_node",
              "attention",
              "started_at",
              "conversation_id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "type": "string"
              },
              "current_node": {
                "type": "string"
              },
              "attention": {
                "type": "boolean"
              },
              "started_at": {
                "type": "string",
                "format": "date-time"
              },
              "conversation_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          "maxItems": 50
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correlation_id"
          ],
          "properties": {
            "correlation_id": {
              "type": "string"
            }
          }
        }
      }
    },
    "m2-retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "const": "operator_retry"
        }
      }
    },
    "m2-agents-list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "next_cursor",
        "meta"
      ],
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "attention",
              "conversation_id",
              "created_at",
              "error_code"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "type": "string"
              },
              "attention": {
                "type": "boolean"
              },
              "conversation_id": {
                "type": "string",
                "format": "uuid"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "error_code": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "maxItems": 50
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correlation_id"
          ],
          "properties": {
            "correlation_id": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
