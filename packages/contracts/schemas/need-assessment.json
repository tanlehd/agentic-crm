{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "need-assessment.json",
  "definitions": {
    "need-assessment-input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "values": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "release_pins": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "required": []
    },
    "need-enrich-input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "need-outcome-input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "record_id"
      ]
    },
    "need-assessment-result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "conversation_id": {
              "type": "string",
              "format": "uuid"
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "need_id": {
              "type": "string",
              "format": "uuid"
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            }
          },
          "required": [
            "conversation_id",
            "session_id",
            "need_id",
            "version"
          ]
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "correlation_id": {
              "type": "string"
            }
          },
          "required": [
            "correlation_id"
          ]
        }
      },
      "required": [
        "data",
        "meta"
      ]
    },
    "need-assessment-response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "conversation_id": {
              "type": "string",
              "format": "uuid"
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "need_id": {
              "type": "string",
              "format": "uuid"
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            "outcomes": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "label": {
                    "type": "string"
                  },
                  "linked": {
                    "type": "boolean"
                  },
                  "can_link": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "label",
                  "linked",
                  "can_link"
                ]
              }
            },
            "can_edit": {
              "type": "boolean"
            },
            "definitions": {
              "type": "array",
              "maxItems": 105,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "key": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "type": {
                    "enum": [
                      "string",
                      "text",
                      "integer",
                      "decimal",
                      "boolean",
                      "date",
                      "datetime",
                      "enum"
                    ]
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "default_value": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "options": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "string"
                    }
                  },
                  "indexed": {
                    "type": "boolean"
                  },
                  "sensitive": {
                    "type": "boolean"
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,19})$"
                  },
                  "can_write": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "key",
                  "label",
                  "type",
                  "required",
                  "default_value",
                  "options",
                  "indexed",
                  "sensitive",
                  "version",
                  "can_write"
                ]
              }
            },
            "values": {
              "type": "object",
              "maxProperties": 100,
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            },
            "pinned": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "proposal": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "values": {
                  "type": "object",
                  "maxProperties": 100,
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "evidence_ids": {
                  "type": "array",
                  "maxItems": 100,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "provider": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                },
                "config_version": {
                  "type": "string"
                },
                "input_fingerprint": {
                  "type": "string"
                },
                "assessed_at": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "values"
              ]
            },
            "history": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "version": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,19})$"
                  },
                  "values": {
                    "type": "object",
                    "maxProperties": 100,
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    }
                  },
                  "recorded_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "proposal": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "values": {
                        "type": "object",
                        "maxProperties": 100,
                        "additionalProperties": {
                          "type": [
                            "string",
                            "number",
                            "boolean",
                            "null"
                          ]
                        }
                      },
                      "confidence": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "evidence_ids": {
                        "type": "array",
                        "maxItems": 100,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "format": "uuid"
                        }
                      },
                      "provider": {
                        "type": "string"
                      },
                      "model": {
                        "type": "string"
                      },
                      "config_version": {
                        "type": "string"
                      },
                      "input_fingerprint": {
                        "type": "string"
                      },
                      "assessed_at": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "values"
                    ]
                  }
                },
                "required": [
                  "version",
                  "values",
                  "recorded_at",
                  "proposal"
                ]
              }
            }
          },
          "required": [
            "conversation_id",
            "session_id",
            "need_id",
            "version",
            "outcomes",
            "can_edit",
            "definitions",
            "values",
            "pinned",
            "proposal",
            "history"
          ]
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "correlation_id": {
              "type": "string"
            }
          },
          "required": [
            "correlation_id"
          ]
        }
      },
      "required": [
        "data",
        "meta"
      ]
    },
    "need-assessed-event-data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "type": "string",
          "format": "uuid"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "need_id": {
          "type": "string",
          "format": "uuid"
        },
        "assessment_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "contact_id": {
          "type": "string",
          "format": "uuid"
        },
        "connection_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "conversation_id",
        "session_id",
        "need_id",
        "assessment_version",
        "contact_id",
        "connection_id"
      ]
    }
  }
}
