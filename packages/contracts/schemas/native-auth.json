{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-crm.local/schemas/native-auth.json",
  "title": "NativeAuthentication",
  "definitions": {
    "NativeLoginRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "login_key",
        "password",
        "csrf_token"
      ],
      "properties": {
        "login_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.@-]{3,128}$"
        },
        "password": {
          "type": "string",
          "maxLength": 128
        },
        "csrf_token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "NativePasswordChangeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_password",
        "new_password"
      ],
      "properties": {
        "current_password": {
          "type": "string",
          "maxLength": 128
        },
        "new_password": {
          "type": "string",
          "minLength": 15,
          "maxLength": 128
        }
      }
    },
    "NativeResetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "login_key"
      ],
      "properties": {
        "login_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.@-]{3,128}$"
        }
      }
    },
    "NativeResetCompleteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token",
        "new_password"
      ],
      "properties": {
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "new_password": {
          "type": "string",
          "minLength": 15,
          "maxLength": 128
        }
      }
    }
  }
}
