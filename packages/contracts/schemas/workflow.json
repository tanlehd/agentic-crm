{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "workflow",
  "type": "object",
  "definitions": {
    "workflow-graph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "event_type": {
              "const": "conversation.created"
            },
            "connection_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "event_type",
            "connection_id"
          ]
        },
        "entry_node": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,47}$"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,47}$"
                  },
                  "type": {
                    "const": "assign_owner"
                  },
                  "config": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "record_id": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "uuid"
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "ref": {
                                "type": "string",
                                "pattern": "^(trigger\\.(aggregate_id|contact_id|connection_id)|outputs\\.[a-z][a-z0-9_]{0,47}\\.[a-z_]+)$"
                              }
                            },
                            "required": [
                              "ref"
                            ]
                          }
                        ]
                      },
                      "team_id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "capability": {
                        "enum": [
                          "chat",
                          "sales"
                        ]
                      },
                      "preference": {
                        "enum": [
                          "human",
                          "ai",
                          "any"
                        ]
                      }
                    },
                    "required": [
                      "record_id",
                      "team_id",
                      "capability",
                      "preference"
                    ]
                  },
                  "next": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,47}$"
                  }
                },
                "required": [
                  "key",
                  "type",
                  "config",
                  "next"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,47}$"
                  },
                  "type": {
                    "const": "start_chatflow"
                  },
                  "config": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "conversation_id": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "uuid"
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "ref": {
                                "type": "string",
                                "pattern": "^(trigger\\.(aggregate_id|contact_id|connection_id)|outputs\\.[a-z][a-z0-9_]{0,47}\\.[a-z_]+)$"
                              }
                            },
                            "required": [
                              "ref"
                            ]
                          }
                        ]
                      },
                      "chatflow_version_id": {
                        "type": "string",
                        "format": "uuid"
                      }
                    },
                    "required": [
                      "conversation_id",
                      "chatflow_version_id"
                    ]
                  },
                  "next": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,47}$"
                  }
                },
                "required": [
                  "key",
                  "type",
                  "config",
                  "next"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,47}$"
                  },
                  "type": {
                    "const": "request_lead_handoff"
                  },
                  "config": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "lead_id": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "uuid"
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "ref": {
                                "type": "string",
                                "pattern": "^(trigger\\.(aggregate_id|contact_id|connection_id)|outputs\\.[a-z][a-z0-9_]{0,47}\\.[a-z_]+)$"
                              }
                            },
                            "required": [
                              "ref"
                            ]
                          }
                        ]
                      },
                      "target_team_id": {
                        "type": "string",
                        "format": "uuid"
                      }
                    },
                    "required": [
                      "lead_id",
                      "target_team_id"
                    ]
                  },
                  "next": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,47}$"
                  }
                },
                "required": [
                  "key",
                  "type",
                  "config",
                  "next"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,47}$"
                  },
                  "type": {
                    "const": "wait_event"
                  },
                  "config": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "event_type": {
                        "enum": [
                          "chatflow.completed",
                          "lead.accepted"
                        ]
                      },
                      "match_key": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "ref": {
                            "type": "string",
                            "pattern": "^(trigger\\.(aggregate_id|contact_id|connection_id)|outputs\\.[a-z][a-z0-9_]{0,47}\\.[a-z_]+)$"
                          }
                        },
                        "required": [
                          "ref"
                        ]
                      },
                      "timeout_seconds": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 86400
                      }
                    },
                    "required": [
                      "event_type",
                      "match_key",
                      "timeout_seconds"
                    ]
                  },
                  "next": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,47}$"
                  },
                  "on_timeout": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,47}$"
                  }
                },
                "required": [
                  "key",
                  "type",
                  "config",
                  "next",
                  "on_timeout"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,47}$"
                  },
                  "type": {
                    "const": "wait_timer"
                  },
                  "config": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "duration_seconds": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 86400
                      }
                    },
                    "required": [
                      "duration_seconds"
                    ]
                  },
                  "next": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,47}$"
                  }
                },
                "required": [
                  "key",
                  "type",
                  "config",
                  "next"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,47}$"
                  },
                  "type": {
                    "const": "condition"
                  },
                  "config": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "left": {
                        "anyOf": [
                          {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ]
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "ref": {
                                "type": "string",
                                "pattern": "^(trigger\\.(aggregate_id|contact_id|connection_id)|outputs\\.[a-z][a-z0-9_]{0,47}\\.[a-z_]+)$"
                              }
                            },
                            "required": [
                              "ref"
                            ]
                          }
                        ]
                      },
                      "op": {
                        "enum": [
                          "eq",
                          "exists"
                        ]
                      },
                      "right": {
                        "anyOf": [
                          {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ]
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "ref": {
                                "type": "string",
                                "pattern": "^(trigger\\.(aggregate_id|contact_id|connection_id)|outputs\\.[a-z][a-z0-9_]{0,47}\\.[a-z_]+)$"
                              }
                            },
                            "required": [
                              "ref"
                            ]
                          }
                        ]
                      },
                      "on_true": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,47}$"
                      },
                      "on_false": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,47}$"
                      }
                    },
                    "required": [
                      "left",
                      "op",
                      "on_true",
                      "on_false"
                    ]
                  }
                },
                "required": [
                  "key",
                  "type",
                  "config"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,47}$"
                  },
                  "type": {
                    "const": "end"
                  },
                  "config": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "outcome": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,63}$"
                      }
                    },
                    "required": [
                      "outcome"
                    ]
                  }
                },
                "required": [
                  "key",
                  "type",
                  "config"
                ]
              }
            ]
          }
        }
      },
      "required": [
        "trigger",
        "entry_node",
        "nodes"
      ]
    },
    "workflow-create": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "service_actor_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "key",
        "name",
        "service_actor_id"
      ]
    },
    "workflow-version-create": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "graph": {
          "$ref": "#/definitions/workflow-graph"
        },
        "execution_role_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "graph",
        "execution_role_id"
      ]
    },
    "workflow-publish": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "workflow-enable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "workflow-cancel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason": {
          "const": "operator_cancelled"
        }
      },
      "required": [
        "reason"
      ]
    },
    "workflow-mutation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "version": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "number": {
              "type": "integer"
            },
            "state": {
              "enum": [
                "draft"
              ]
            },
            "definition_version": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "status": {
              "enum": [
                "cancelled",
                "completed",
                "failed"
              ]
            }
          },
          "required": [
            "id"
          ]
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "correlation_id": {
              "type": "string"
            }
          },
          "required": [
            "correlation_id"
          ]
        }
      },
      "required": [
        "data",
        "meta"
      ]
    },
    "workflow-list": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "key": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "service_actor_id": {
                "type": "string",
                "format": "uuid"
              },
              "active_version_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "enabled": {
                "type": "boolean"
              },
              "version": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,19}$"
              }
            },
            "required": [
              "id",
              "key",
              "name",
              "service_actor_id",
              "active_version_id",
              "enabled",
              "version"
            ]
          }
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "correlation_id": {
              "type": "string"
            }
          },
          "required": [
            "correlation_id"
          ]
        }
      },
      "required": [
        "data",
        "meta"
      ]
    },
    "workflow-versions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "number": {
                "type": "integer"
              },
              "state": {
                "enum": [
                  "draft",
                  "published"
                ]
              },
              "graph": {
                "$ref": "#/definitions/workflow-graph"
              },
              "execution_role_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "id",
              "number",
              "state",
              "graph",
              "execution_role_id"
            ]
          }
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "correlation_id": {
              "type": "string"
            }
          },
          "required": [
            "correlation_id"
          ]
        }
      },
      "required": [
        "data",
        "meta"
      ]
    },
    "workflow-run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "definition_id": {
              "type": "string",
              "format": "uuid"
            },
            "version_id": {
              "type": "string",
              "format": "uuid"
            },
            "status": {
              "enum": [
                "queued",
                "running",
                "waiting",
                "completed",
                "failed",
                "cancelled"
              ]
            },
            "current_node": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,47}$"
            },
            "error_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "attention": {
              "type": "boolean"
            },
            "cancel_pending": {
              "type": "boolean"
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "node_key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,47}$"
                  },
                  "status": {
                    "type": "string"
                  },
                  "attempt": {
                    "type": "integer"
                  },
                  "error_code": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "node_key",
                  "status",
                  "attempt",
                  "error_code"
                ]
              }
            },
            "waits": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "node_key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,47}$"
                  },
                  "kind": {
                    "enum": [
                      "timer",
                      "event"
                    ]
                  },
                  "status": {
                    "type": "string"
                  },
                  "resume_at": {
                    "type": "string"
                  }
                },
                "required": [
                  "node_key",
                  "kind",
                  "status",
                  "resume_at"
                ]
              }
            }
          },
          "required": [
            "id",
            "definition_id",
            "version_id",
            "status",
            "current_node",
            "error_code",
            "attention",
            "cancel_pending",
            "steps",
            "waits"
          ]
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "correlation_id": {
              "type": "string"
            }
          },
          "required": [
            "correlation_id"
          ]
        }
      },
      "required": [
        "data",
        "meta"
      ]
    }
  }
}
