          "type": "string",
          "format": "uuid"
        },
        "connection_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "uuid"
            }
          ]
        },
        "skill_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "maxItems": 200,
          "uniqueItems": true
        },
        "priority": {
