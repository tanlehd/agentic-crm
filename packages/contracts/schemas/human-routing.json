{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "human-routing.json",
  "definitions": {
    "human-routing-skills": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        }
      },
      "required": [
        "key",
        "name"
      ],
      "additionalProperties": false
    },
    "human-routing-team-skills": {
      "type": "object",
      "properties": {
        "team_id": {
          "type": "string",
          "format": "uuid"
        },
        "skill_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "maxItems": 200,
          "uniqueItems": true
        }
      },
      "required": [
        "team_id",
        "skill_ids"
      ],
      "additionalProperties": false
    },
    "human-routing-profiles": {
      "type": "object",
      "properties": {
        "principal_id": {
          "type": "string",
          "format": "uuid"
        },
        "capacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "principal_id",
        "capacity",
        "enabled"
      ],
      "additionalProperties": false
    },
    "human-routing-queues": {
      "type": "object",
