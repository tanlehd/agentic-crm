{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-crm.local/schemas/registry.json",
  "title": "RegistryFoundation",
  "definitions": {
    "registry-object-create": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        }
      }
    },
    "registry-type-create": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "source_type",
        "target_type",
        "cardinality"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        "source_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "target_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "cardinality": {
          "enum": [
            "many_to_many",
            "one_to_many",
            "one_to_one"
          ]
        }
      }
    },
    "registry-association-create": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_key",
        "source_record_id",
        "target_record_id"
      ],
      "properties": {
        "type_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "source_record_id": {
          "type": "string",
          "format": "uuid"
        },
        "target_record_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "registry-object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tenant_id",
        "key",
        "label",
        "version",
        "kind",
        "schema_version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "kind": {
          "enum": [
            "standard",
            "custom"
          ]
        },
        "schema_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        }
      }
    },
    "registry-type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tenant_id",
        "key",
        "label",
        "version",
        "source_object_type_id",
        "target_object_type_id",
        "cardinality"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "source_object_type_id": {
          "type": "string",
          "format": "uuid"
        },
        "target_object_type_id": {
          "type": "string",
          "format": "uuid"
        },
        "cardinality": {
          "enum": [
            "many_to_many",
            "one_to_many",
            "one_to_one"
          ]
        }
      }
    },
    "registry-association": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tenant_id",
        "association_type_id",
        "source_record_id",
        "target_record_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "association_type_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_record_id": {
          "type": "string",
          "format": "uuid"
        },
        "target_record_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "registry-association-created": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tenant_id",
        "association_type_id",
        "source_record_id",
        "target_record_id",
        "source_version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "association_type_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_record_id": {
          "type": "string",
          "format": "uuid"
        },
        "target_record_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        }
      }
    },
    "registry-object-list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "next_cursor",
        "meta"
      ],
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/registry-object"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correlation_id"
          ],
          "properties": {
            "correlation_id": {
              "type": "string"
            }
          }
        }
      }
    },
    "registry-object-response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "meta"
      ],
      "properties": {
        "data": {
          "$ref": "#/definitions/registry-object"
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correlation_id"
          ],
          "properties": {
            "correlation_id": {
              "type": "string"
            }
          }
        }
      }
    },
    "registry-type-list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "next_cursor",
        "meta"
      ],
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/registry-type"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correlation_id"
          ],
          "properties": {
            "correlation_id": {
              "type": "string"
            }
          }
        }
      }
    },
    "registry-type-response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "meta"
      ],
      "properties": {
        "data": {
          "$ref": "#/definitions/registry-type"
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correlation_id"
          ],
          "properties": {
            "correlation_id": {
              "type": "string"
            }
          }
        }
      }
    },
    "registry-association-list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "next_cursor",
        "meta"
      ],
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/registry-association"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correlation_id"
          ],
          "properties": {
            "correlation_id": {
              "type": "string"
            }
          }
        }
      }
    },
    "registry-association-response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "meta"
      ],
      "properties": {
        "data": {
          "$ref": "#/definitions/registry-association-created"
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correlation_id"
          ],
          "properties": {
            "correlation_id": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
