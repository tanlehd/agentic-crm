{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-crm.local/schemas/chat-catalogs.json",
  "title": "ChatWorkspaceCatalogs",
  "definitions": {
    "catalog-predicate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "enum": [
            "all",
            "mine",
            "unassigned",
            "team"
          ]
        },
        "team_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "array",
          "items": {
            "enum": [
              "open",
              "pending",
              "closed"
            ]
          },
          "maxItems": 3,
          "minItems": 1,
          "uniqueItems": true
        },
        "snooze": {
          "enum": [
            "exclude",
            "include",
            "only"
          ]
        },
        "unread": {
          "enum": [
            "any",
            "only"
          ]
        },
        "channel": {
          "enum": [
            "messenger",
            "mock_messenger"
          ]
        },
        "channel_id": {
          "type": "string",
          "format": "uuid"
        },
        "tag_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "maxItems": 10,
          "uniqueItems": true
        }
      },
      "required": [
        "scope",
        "status",
        "snooze",
        "unread"
      ]
    },
    "catalog-predicate-input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "enum": [
            "all",
            "mine",
            "unassigned",
            "team"
          ]
        },
        "team_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "array",
          "items": {
            "enum": [
              "open",
              "pending",
              "closed"
            ]
          },
          "maxItems": 3,
          "minItems": 1,
          "uniqueItems": true
        },
        "snooze": {
          "enum": [
            "exclude",
            "include",
            "only"
          ]
        },
        "unread": {
          "enum": [
            "any",
            "only"
          ]
        },
        "channel": {
          "enum": [
            "messenger",
            "mock_messenger"
          ]
        },
        "channel_id": {
          "type": "string",
          "format": "uuid"
        },
        "tag_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "maxItems": 10,
          "uniqueItems": true
        }
      },
      "required": []
    },
    "catalog-tag-create": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "color": {
          "enum": [
            "gray",
            "blue",
            "green",
            "amber",
            "red",
            "purple"
          ]
        }
      },
      "required": [
        "name",
        "color"
      ]
    },
    "catalog-tag-patch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
