          "enum": [
            "gray",
            "blue",
            "green",
            "amber",
            "red",
            "purple"
          ]
        }
      },
      "required": [],
      "minProperties": 1
    },
    "catalog-tag": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "color": {
          "enum": [
            "gray",
            "blue",
            "green",
            "amber",
            "red",
            "purple"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "archived": {
          "type": "boolean"
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        }
      },
      "required": [
        "id",
        "name",
        "color",
        "version",
        "archived",
        "allowed_actions"
      ]
    },
